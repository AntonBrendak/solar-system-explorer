{
  "name": "solar-system-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "prepare:textures": "node scripts/prepare-planet-tiers.mjs",
    "prepare:og": "node scripts/prepare-og-images.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "astronomy-engine": "^2.1.19",
    "fast-png": "8.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.66.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vinext/cloudflare": "1.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "vite-css-modules": "1.16.1",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
